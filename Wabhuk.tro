-- ═══════════════════════════════════════════════════════════════════
-- 🎨 الإعدادات
-- ═══════════════════════════════════════════════════════════════════
local WEBHOOK_NAME = "TRO + WAVOR SECURITY"
local WEBHOOK_AVATAR = "https://cdn-icons-png.flaticon.com/512/2592/2592220.png"
local DELAY = 3  -- الفاصل بين كل رسالة

-- ═══════════════════════════════════════════════════════════════════
-- 📨 دالة الإرسال
-- ═══════════════════════════════════════════════════════════════════
local function sendEmbed(payload)
    local body = HttpS:JSONEncode(payload)
    local headers = {["Content-Type"] = "application/json"}
    
    local ok, result = pcall(function()
        if syn and syn.request then
            return syn.request({Url = WEBHOOK_URL, Method = "POST", Headers = headers, Body = body})
        elseif request then
            return request({Url = WEBHOOK_URL, Method = "POST", Headers = headers, Body = body})
        elseif http_request then
            return http_request({Url = WEBHOOK_URL, Method = "POST", Headers = headers, Body = body})
        else
            return HttpS:RequestAsync({Url = WEBHOOK_URL, Method = "POST", Headers = headers, Body = body})
        end
    end)
    
    return ok, result
end

