-- ═══════════════════════════════════════════════════════════════════
-- 🚀 التشغيل
-- ═══════════════════════════════════════════════════════════════════
print("═══════════════════════════════════════════════")
print("  👑 TRO + WAVOR — PREMIUM WEBHOOK SENDER")
print("  📨 إرسال " .. #MESSAGES .. " رسالة فخمة...")
print("═══════════════════════════════════════════════")

task.spawn(function()
    for i, msg in ipairs(MESSAGES) do
        -- نجهز الـpayload
        local payload = {
            username = WEBHOOK_NAME,
            avatar_url = WEBHOOK_AVATAR,
        }
        
        -- إذا في content، نضيفه
        if msg.content then
            payload.content = msg.content
        end
        
        -- نضيف الـembed
        if msg.embeds then
            payload.embeds = msg.embeds
        end
        
        local ok, result = sendEmbed(payload)
        
        -- نتحقق من النتيجة
        local statusCode = nil
        if type(result) == "table" then
            statusCode = result.StatusCode or result.status
        end
        
        if ok and (statusCode == 200 or statusCode == 204 or statusCode == nil) then
            print("✅ [" .. i .. "/" .. #MESSAGES .. "] تم إرسال الرسالة " .. i)
        elseif statusCode == 429 then
            print("⚠️ [" .. i .. "] Rate Limited! ننتظر 5 ثواني...")
            task.wait(5)
            -- نعيد المحاولة
            sendEmbed(payload)
        else
            print("❌ [" .. i .. "] فشل: " .. tostring(result))
        end
        
        -- ننتظر قبل الرسالة التالية
        if i < #MESSAGES then
            task.wait(DELAY)
        end
    end
    
    print("═══════════════════════════════════════════════")
    print("  ✅ انتهى الإرسال بنجاح!")
    print("═══════════════════════════════════════════════")
end)
